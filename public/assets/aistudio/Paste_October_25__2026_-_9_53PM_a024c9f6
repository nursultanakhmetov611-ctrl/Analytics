    const cust = tr.querySelector('.row-cust, input[list="cust-list"]')?.value?.trim() || tr.children[2]?.textContent?.trim() || '';
    const num = tr.querySelector('.row-wagon')?.value?.trim() || tr.children[3]?.textContent?.trim() || '';
    const typeSelect = tr.querySelector('.row-wagon-type');
    const type = typeSelect ? typeSelect.value : (tr.children[4]?.textContent?.trim() || '');
    const repSelect = tr.querySelector('.row-repair');
    const repair = repSelect ? repSelect.value : (tr.children[5]?.textContent?.trim() || '');
    const date = tr.querySelector('.row-date')?.value?.trim() || tr.children[6]?.textContent?.trim() || '';
    const loc = tr.querySelector('.row-loc')?.value?.trim() || tr.children[7]?.textContent?.trim() || '';
    const reason = tr.querySelector('.row-reason')?.value?.trim() || tr.children[8]?.textContent?.trim() || '';
    const dCode = tr.getAttribute('data-depot') || depot;

    if (num || cust || status) {
      wagonRows.push({ idx: idx + 1, depot: dCode, status, cust, num, type, repair, date, loc, reason });
    }
  });

  // 3. Сбор колёсных пар (КП)
  const getKp = (id, stateKey) => {
    const el = document.getElementById(id);
